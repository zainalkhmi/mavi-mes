# =====================================================
# Mavi MES Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =====================================================

# =====================================================
# SUPABASE (Required)
# =====================================================
# Get these from your Supabase project settings
# Dashboard > Settings > API
VITE_SUPABASE_URL=https://pypjnzvsolxsddsqworw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB5cGpuenZzb2x4c2Rkc3F3b3J3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcxMTQ1MDQsImV4cCI6MjA5MjY5MDUwNH0.kjKlJu336ZqIOEk4SV7WhPrhsHzQv-rrKDh-oPasbAc

# =====================================================
# SENTRY (Optional - for error tracking)
# =====================================================
# Get from Sentry.io dashboard
# Projects > your-project > Settings > Client Keys
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-number

# =====================================================
# AI SERVICES (Optional)
# =====================================================
# Gemini API for AI features
VITE_GEMINI_API_KEY=

# OpenAI API (alternative)
VITE_OPENAI_API_KEY=

# =====================================================
# n8n WEBHOOK (Optional)
# =====================================================
# For workflow automation
VITE_N8N_WEBHOOK_URL=

# =====================================================
# APPLICATION
# =====================================================
# Environment: development | staging | production
VITE_APP_ENV=development

# App version (auto-populated by build)
VITE_APP_VERSION=1.0.0

# =====================================================
# FEATURE FLAGS
# =====================================================
# Enable/disable features
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_ADVANCED_CHARTS=true
VITE_FEATURE_EXPORT_PDF=true
