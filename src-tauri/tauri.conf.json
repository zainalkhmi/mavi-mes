{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mavi Builder",
  "version": "1.0.0",
  "identifier": "com.mavicore.builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MaviCore MES Builder",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "decorations": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "shortDescription": "MaviCore MES App Builder",
    "longDescription": "Build MES applications with drag-drop UI builder, AI code generation, and real-time preview.",
    "category": "DeveloperTool",
    "publisher": "MaviCore",
    "copyright": "Copyright 2024 MaviCore"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
